# Copy to .env (git-ignored). Placeholders only — never commit real values.

# --- Meta Model API (backend only) ---
# Paste your key into .env only. Leave empty to run without AI (deterministic fallback).
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Model IDs (override if Meta renames a preview model)
MODEL_INVESTIGATOR=muse-spark-1.3
MODEL_DEEP=muse-wonder-1.0
MODEL_IMAGE=muse-image-1.0
MODEL_VOICE=muse-voice-transcribe-1.0
MODEL_SEGMENT=sam-3.1
# Muse Image report illustrations are off unless explicitly enabled
ENABLE_REPORT_IMAGES=0

# --- Optional open-weight assessors (OpenAI-compatible: vLLM / SGLang / hosted) ---
# Muse Spark Open on Baseten Model APIs (serverless, verified 2026-10-29):
#   SPARK_OPEN_BASE_URL=https://inference.baseten.co/v1
#   SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
#   SPARK_OPEN_API_KEY=<your Baseten API key>
# Baseten lists no Glimmer model. Free option: NVIDIA API catalog (developer credits, key from build.nvidia.com):
#   GLIMMER_BASE_URL=https://integrate.api.nvidia.com/v1
#   GLIMMER_MODEL=meta/muse-glimmer-30b
#   GLIMMER_API_KEY=<your nvapi-... key>
# (OpenRouter also serves meta/muse-glimmer-30b, but at paid rates.)
GLIMMER_BASE_URL=
GLIMMER_MODEL=
GLIMMER_API_KEY=
SPARK_OPEN_BASE_URL=
SPARK_OPEN_MODEL=
SPARK_OPEN_API_KEY=

# --- Scanners ---
# auto | cli | api
OSV_MODE=auto
# path to osv-scanner if not on PATH
OSV_SCANNER_BIN=
# auto | local | docker | off
GUARDDOG_MODE=auto
# auto | local | docker | off  (fix simulation)
NPM_RESOLVER=auto
# packages per scan that get tarball-level malware checks
DEEP_SCAN_LIMIT=15

# --- Intake / web ---
# optional, raises GitHub API rate limit (read-only, public repos)
GITHUB_TOKEN=
ALLOWED_ORIGINS=http://localhost:8000
SERVE_FRONTEND=1
